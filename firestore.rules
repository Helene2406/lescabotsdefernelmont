rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function estConnecte() {
      return request.auth != null;
    }
    function estAdmin() {
      return estConnecte() &&
        get(/databases/$(database)/documents/membres/$(request.auth.uid)).data.role == 'admin';
    }

    function champsAutorisesMembre() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['nomMaitre','gsm','email','adressePostale','dateAnniversaire',
                  'chiens','assuranceRC',
                  'cotisationRenouvellement','abonnementRenouvellement','dernierBlogVu']);
    }

    match /membres/{uid} {
      allow read: if estConnecte() && (request.auth.uid == uid || estAdmin());
      allow create: if estAdmin();
      allow update: if estAdmin() || (estConnecte() && request.auth.uid == uid && champsAutorisesMembre());
      allow delete: if estAdmin();
    }

    match /groupes/{id} {
      allow read: if estConnecte();
      allow write: if estAdmin();
    }

    match /presences/{id} {
      allow read: if estConnecte();
      allow create, update: if estConnecte();
      allow delete: if estAdmin();
    }

    match /annulations/{id} {
      allow read: if estConnecte();
      allow write: if estAdmin();
    }

    match /confirmations/{id} {
      allow read: if estConnecte();
      allow write: if estAdmin();
    }

    match /services/{id} {
      allow read: if estConnecte();
      allow write: if estAdmin();
    }

    match /rdv/{id} {
      allow read: if estConnecte();
      allow write: if estAdmin();
    }

    match /rdv_reponses/{id} {
      allow read: if estConnecte();
      allow create, update: if estConnecte();
      allow delete: if estAdmin();
    }

    match /conversations/{uid} {
      allow read, write: if estConnecte() && (request.auth.uid == uid || estAdmin());
      match /messages/{msgId} {
        allow read, create, update: if estConnecte() && (request.auth.uid == uid || estAdmin());
      }
    }

    match /articles/{id} {
      allow read: if estConnecte();
      allow write: if estAdmin();
    }

    match /videos/{id} {
      allow read: if estConnecte();
      allow write: if estAdmin();
      match /commentaires/{cid} {
        allow read: if estConnecte();
        allow create: if estConnecte();
        allow delete: if estAdmin();
      }
    }

    match /paiements/{id} {
      allow read: if estConnecte() && (resource.data.membreId == request.auth.uid || estAdmin());
      allow create, update, delete: if estAdmin();
    }

    match /parametres/{id} {
      allow read: if estConnecte();
      allow write: if estAdmin();
    }

    match /articles_boutique/{id} {
      allow read: if estConnecte();
      allow write: if estAdmin();
    }

    match /commandes/{id} {
      allow read: if estConnecte() && (resource.data.membreId == request.auth.uid || estAdmin());
      allow create: if estConnecte() && request.resource.data.membreId == request.auth.uid;
      allow update, delete: if estAdmin();
    }

    match /factures/{id} {
      allow read: if estConnecte() && (resource.data.membreId == request.auth.uid || estAdmin());
      allow create, update, delete: if estAdmin();
    }
  }
}
